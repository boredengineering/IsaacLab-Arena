                    token[] semantics:labels:material = ["Soda-lime glass"]
                    float physics:density = 2500
                    float physics:staticFriction = 0.5
                    float physics:dynamicFriction = 0.4
                    float physics:restitution = 0.4
                  }

            def Material "polyethylene_foam_liner" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "SemanticsLabelsAPI:material"]
                  )
                  {
                    token[] semantics:labels:material = ["Polyethylene foam liner"]
                    float physics:density = 550
                    float physics:staticFriction = 0.6
                    float physics:dynamicFriction = 0.5
                    float physics:restitution = 0.1
                  }

            def Material "lacquered_tinplate_knurled" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "SemanticsLabelsAPI:material"]
                  )
