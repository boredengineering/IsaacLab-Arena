#usda 1.0
(
    defaultPrim = "Model"
    doc = "ForgeCAD animation clips for the root stage. Generated by forgecad export usd; do not edit."
    endTimeCode = 144
    startTimeCode = 0
    timeCodesPerSecond = 24
)

over "Model" (
    prepend variantSets = "animation"
    variants = {
        string animation = "static"
    }
)
{
    variantSet "animation" = {
        "static" {
        }
        "Open_each_front" {
            over "Geometry"
            {
                over "Carcass"
                {
                    over "Drawer_1"
                    {
                        double3 xformOp:translate:drawer_1.timeSamples = {
                            0: (0, 0, 0),
                            36: (0.473, 0, 0),
                            72: (0, 0, 0),
                            108: (0, 0, 0),
                            144: (0, 0, 0),
                        }
                    }
                    over "Door_1"
                    {
                        float xformOp:rotateX:door_1.timeSamples = {
                            0: 0,
                            36: 0,
                            72: 0,
                            108: 110,
                            144: 0,
                        }
                    }
                }
            }
        }
    }
}
