#usda 1.0
(
    defaultPrim = "Model"
    doc = "ForgeCAD animation clips for the root stage. Generated by forgecad export usd; do not edit."
    endTimeCode = 192
    startTimeCode = 0
    timeCodesPerSecond = 24
)

over "Model" (
    prepend variantSets = "animation"
    variants = {
        string animation = "static"
    }
)
{
    variantSet "animation" = {
        "static" {
        }
        "Unscrew_and_screw" {
            over "Geometry"
            {
                over "Jar"
                {
                    over "Liner"
                    {
                        double3 xformOp:translate:lid_lift.timeSamples = {
                            0: (0, 0, 0),
                            64: (0.00635, 0, 0),
                            128: (0.00635, 0, 0),
                            192: (0, 0, 0),
                        }
                        over "Lid"
                        {
                            float xformOp:rotateX:lid_turn.timeSamples = {
                                0: 0,
                                64: 540,
                                128: 540,
                                192: 0,
                            }
                        }
                    }
                }
            }
        }
    }
}
