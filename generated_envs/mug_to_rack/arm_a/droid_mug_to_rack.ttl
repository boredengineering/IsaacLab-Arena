@prefix : <https://isaac-sim.github.io/arena/instances/> .
@prefix arena: <https://isaac-sim.github.io/arena/schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:franka_pick_mug_place_rack a prov:Entity,
        arena:EnvironmentGraph ;
    arena:envName "franka_pick_mug_place_rack"^^xsd:string ;
    arena:hasCamera :franka_pick_mug_place_rack_viewer_cam ;
    arena:hasEmbodiment :franka_robot ;
    arena:hasFixture :maple_table ;
    arena:hasObject :dish_rack,
        :mug ;
    arena:hasTerrain :default_ground_plane .

:reifier_mug_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :mug ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.05"^^xsd:float ;
    arena:priorEntropy "2.5"^^xsd:float ;
    arena:requiredFriction "0.6"^^xsd:float ;
    arena:requiredHeadroom "0.35"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:reifier_rack_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :dish_rack ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.05"^^xsd:float ;
    arena:priorEntropy "2.5"^^xsd:float ;
    arena:requiredFriction "0.6"^^xsd:float ;
    arena:requiredHeadroom "0.35"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:default_ground_plane a arena:Terrain ;
    arena:registryName "default_ground_plane"^^xsd:string .

:franka_pick_mug_place_rack_viewer_cam a arena:Camera ;
    arena:lookAtTarget :mug ;
    arena:observes :mug ;
    arena:observesInteraction :mug .

:franka_robot a arena:Embodiment ;
    arena:registryName "franka_ik"^^xsd:string ;
    arena:standoffDistance "0.85"^^xsd:float ;
    arena:standsAtAffordance :maple_table .

:dish_rack a arena:Receptacle,
        arena:RigidObject ;
    arena:placedOn :maple_table ;
    arena:placedOnSubSurface :maple_table_table_top ;
    arena:registryName "rack_l04_vomp_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table_table_top a arena:SurfaceAnchor ;
    arena:anchorName "table_top"^^xsd:string .

:mug a arena:RigidObject ;
    arena:placedOn :maple_table ;
    arena:placedOnSubSurface :maple_table_table_top ;
    arena:registryName "mug_ycb_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table a arena:Fixture ;
    arena:hasSubSurface :maple_table_table_top ;
    arena:registryName "maple_table_robolab"^^xsd:string .

