@prefix : <https://isaac-sim.github.io/arena/instances/> .
@prefix arena: <https://isaac-sim.github.io/arena/schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:can_on_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :tomato_soup_can ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.02"^^xsd:float ;
    arena:priorEntropy "1.8"^^xsd:float ;
    arena:requiredFriction "0.5"^^xsd:float ;
    arena:requiredHeadroom "0.1"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:container_on_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :container ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.03"^^xsd:float ;
    arena:priorEntropy "2.0"^^xsd:float ;
    arena:requiredFriction "0.65"^^xsd:float ;
    arena:requiredHeadroom "0.15"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:tomato_soup_pick_place_maple_table a prov:Entity,
        arena:EnvironmentGraph ;
    arena:envName "tomato_soup_pick_place_maple_table"^^xsd:string ;
    arena:hasCamera :tomato_soup_pick_place_maple_table_viewer_cam ;
    arena:hasEmbodiment :franka_robot ;
    arena:hasFixture :maple_table ;
    arena:hasObject :container,
        :tomato_soup_can ;
    arena:hasTerrain :default_ground_plane .

:default_ground_plane a arena:Terrain ;
    arena:registryName "default_ground_plane"^^xsd:string .

:franka_robot a arena:Embodiment ;
    arena:registryName "franka_ik"^^xsd:string ;
    arena:standoffDistance "0.85"^^xsd:float ;
    arena:standsAtAffordance :maple_table .

:tomato_soup_pick_place_maple_table_viewer_cam a arena:Camera ;
    arena:lookAtTarget :tomato_soup_can ;
    arena:observes :tomato_soup_can ;
    arena:observesInteraction :tomato_soup_can .

:container a arena:Receptacle,
        arena:RigidObject ;
    arena:placedOn :maple_table ;
    arena:placedOnSubSurface :maple_table_table_top ;
    arena:registryName "bin_b03_vomp_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table_table_top a arena:SurfaceAnchor ;
    arena:anchorName "table_top"^^xsd:string .

:tomato_soup_can a arena:RigidObject ;
    arena:placedOn :maple_table ;
    arena:placedOnSubSurface :maple_table_table_top ;
    arena:registryName "tomato_soup_can_ycb_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table a arena:Fixture ;
    arena:hasSubSurface :maple_table_table_top ;
    arena:registryName "maple_table_robolab"^^xsd:string .

