@prefix arena: <https://isaac-sim.github.io/arena/schema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Classes
arena:EnvironmentGraph a owl:Class, rdfs:Class ;
    rdfs:label "Environment Graph" ;
    rdfs:comment "Declarative attributed scene graph for IsaacLab-Arena." ;
    rdfs:subClassOf prov:Entity .

arena:SceneEntity a owl:Class, rdfs:Class ;
    rdfs:label "Scene Entity" ;
    rdfs:comment "Base class for all physical entities in an arena scene." ;
    rdfs:subClassOf prov:Entity .

arena:Terrain a owl:Class, rdfs:Class ;
    rdfs:label "Terrain" ;
    rdfs:subClassOf arena:SceneEntity .

arena:Embodiment a owl:Class, rdfs:Class ;
    rdfs:label "Embodiment" ;
    rdfs:subClassOf arena:SceneEntity .

arena:Fixture a owl:Class, rdfs:Class ;
    rdfs:label "Fixture" ;
    rdfs:comment "Static scene fixture or architecture." ;
    rdfs:subClassOf arena:SceneEntity .

arena:Furniture a owl:Class, rdfs:Class ;
    rdfs:label "Furniture" ;
    rdfs:comment "Spawned furniture unit (e.g., shelving, table, counter) placed within a room zone." ;
    rdfs:subClassOf arena:Fixture .

arena:USDPrim a owl:Class, rdfs:Class ;
    rdfs:label "USD Prim" ;
    rdfs:comment "Introspected OpenUSD stage primitive representing an internal zone, mesh, or transform anchor." ;
    rdfs:subClassOf arena:SceneEntity .

arena:SurfaceAnchor a owl:Class, rdfs:Class ;
    rdfs:label "Surface Anchor" ;
    rdfs:comment "Specific sub-surface tier, counter top, or designated placement region on a fixture." ;
    rdfs:subClassOf arena:SceneEntity .

arena:RigidObject a owl:Class, rdfs:Class ;
    rdfs:label "Rigid Object" ;
    rdfs:comment "Movable rigid object or manipuland." ;
    rdfs:subClassOf arena:SceneEntity .

arena:Receptacle a owl:Class, rdfs:Class ;
    rdfs:label "Receptacle" ;
    rdfs:comment "Container or bin designed to receive manipulands." ;
    rdfs:subClassOf arena:RigidObject .

arena:Camera a owl:Class, rdfs:Class ;
    rdfs:label "Camera" ;
    rdfs:comment "Sensory or viewport camera observing the scene or robot." ;
    rdfs:subClassOf arena:SceneEntity .

arena:EvaluationRun a owl:Class, rdfs:Class ;
    rdfs:label "Evaluation Run" ;
    rdfs:comment "Recorded policy execution run with provenance and metrics." ;
    rdfs:subClassOf prov:Entity .

# Properties
arena:hasTerrain a owl:ObjectProperty ;
    rdfs:domain arena:EnvironmentGraph ;
    rdfs:range arena:Terrain .

arena:hasEmbodiment a owl:ObjectProperty ;
    rdfs:domain arena:EnvironmentGraph ;
    rdfs:range arena:Embodiment .

arena:hasFixture a owl:ObjectProperty ;
    rdfs:domain arena:EnvironmentGraph ;
    rdfs:range arena:Fixture .

arena:hasObject a owl:ObjectProperty ;
    rdfs:domain arena:EnvironmentGraph ;
    rdfs:range arena:RigidObject .

arena:hasCamera a owl:ObjectProperty ;
    rdfs:domain arena:EnvironmentGraph ;
    rdfs:range arena:Camera .

arena:hasSubPrim a owl:ObjectProperty ;
    rdfs:domain arena:SceneEntity ;
    rdfs:range arena:USDPrim .

arena:attachedToPrim a owl:ObjectProperty ;
    rdfs:domain arena:Fixture ;
    rdfs:range arena:USDPrim .

arena:hasSubSurface a owl:ObjectProperty ;
    rdfs:domain arena:Fixture ;
    rdfs:range arena:SurfaceAnchor .

arena:placedOnSubSurface a owl:ObjectProperty ;
    rdfs:domain arena:RigidObject ;
    rdfs:range arena:SurfaceAnchor .

arena:standsAtAffordance a owl:ObjectProperty ;
    rdfs:domain arena:Embodiment ;
    rdfs:range arena:Fixture .

arena:observes a owl:ObjectProperty ;
    rdfs:domain arena:Camera ;
    rdfs:range arena:SceneEntity .

arena:observesInteraction a owl:ObjectProperty ;
    rdfs:domain arena:Camera ;
    rdfs:range arena:SceneEntity .

arena:lookAtTarget a owl:ObjectProperty ;
    rdfs:domain arena:Camera ;
    rdfs:range arena:SceneEntity .

arena:placedOn a owl:ObjectProperty ;
    rdfs:domain arena:RigidObject ;
    rdfs:range arena:SceneEntity .

arena:placedInside a owl:ObjectProperty ;
    rdfs:domain arena:RigidObject ;
    rdfs:range arena:SceneEntity .

arena:navCorridorTo a owl:ObjectProperty ;
    rdfs:domain arena:SceneEntity ;
    rdfs:range arena:SceneEntity .

