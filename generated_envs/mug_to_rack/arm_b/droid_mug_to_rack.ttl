@prefix : <https://isaac-sim.github.io/arena/instances/> .
@prefix arena: <https://isaac-sim.github.io/arena/schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:mug_to_tray_on_table a prov:Entity,
        arena:EnvironmentGraph ;
    arena:envName "mug_to_tray_on_table"^^xsd:string ;
    arena:hasCamera :mug_to_tray_on_table_viewer_cam ;
    arena:hasEmbodiment :franka_01 ;
    arena:hasFixture :maple_table_01 ;
    arena:hasObject :mug_01,
        :tray_01 ;
    arena:hasTerrain :default_ground_plane .

:reifier_mug_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table_01 ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :mug_01 ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.05"^^xsd:float ;
    arena:priorEntropy "2.5"^^xsd:float ;
    arena:requiredFriction "0.6"^^xsd:float ;
    arena:requiredHeadroom "0.35"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:reifier_tray_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table_01 ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :tray_01 ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.05"^^xsd:float ;
    arena:priorEntropy "2.5"^^xsd:float ;
    arena:requiredFriction "0.6"^^xsd:float ;
    arena:requiredHeadroom "0.35"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:default_ground_plane a arena:Terrain ;
    arena:registryName "default_ground_plane"^^xsd:string .

:franka_01 a arena:Embodiment ;
    arena:registryName "franka_ik"^^xsd:string ;
    arena:standoffDistance "0.85"^^xsd:float ;
    arena:standsAtAffordance :maple_table_01 .

:mug_to_tray_on_table_viewer_cam a arena:Camera ;
    arena:lookAtTarget :mug_01 ;
    arena:observes :mug_01 ;
    arena:observesInteraction :mug_01 .

:tray_01 a arena:Receptacle,
        arena:RigidObject ;
    arena:placedOn :maple_table_01 ;
    arena:placedOnSubSurface :maple_table_01_table_top ;
    arena:registryName "bin_b03_vomp_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table_01_table_top a arena:SurfaceAnchor ;
    arena:anchorName "table_top"^^xsd:string .

:mug_01 a arena:RigidObject ;
    arena:placedOn :maple_table_01 ;
    arena:placedOnSubSurface :maple_table_01_table_top ;
    arena:registryName "mug_ycb_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table_01 a arena:Fixture ;
    arena:hasSubSurface :maple_table_01_table_top ;
    arena:registryName "maple_table_robolab"^^xsd:string .

