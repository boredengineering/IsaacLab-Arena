@prefix : <https://isaac-sim.github.io/arena/instances/> .
@prefix arena: <https://isaac-sim.github.io/arena/schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:franka_tomato_soup_can_bin_b03 a prov:Entity,
        arena:EnvironmentGraph ;
    arena:envName "franka_tomato_soup_can_bin_b03"^^xsd:string ;
    arena:hasCamera :franka_tomato_soup_can_bin_b03_viewer_cam ;
    arena:hasEmbodiment :franka_ik ;
    arena:hasFixture :maple_table_robolab ;
    arena:hasObject :bin_b03_vomp_robolab,
        :tomato_soup_can_ycb_robolab ;
    arena:hasTerrain :default_ground_plane .

:reifier_bin_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table_robolab ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :bin_b03_vomp_robolab ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.05"^^xsd:float ;
    arena:priorEntropy "2.5"^^xsd:float ;
    arena:requiredFriction "0.6"^^xsd:float ;
    arena:requiredHeadroom "0.12"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:reifier_can_table a arena:ReifiedRelation ;
    arena:hasObject :maple_table_robolab ;
    arena:hasPredicate "PLACED_ON"^^xsd:string ;
    arena:hasSubject :tomato_soup_can_ycb_robolab ;
    arena:kinematicManifold "tabletop_stationary_reach"^^xsd:string ;
    arena:posteriorEntropy "0.05"^^xsd:float ;
    arena:priorEntropy "2.5"^^xsd:float ;
    arena:requiredFriction "0.6"^^xsd:float ;
    arena:requiredHeadroom "0.15"^^xsd:float ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:default_ground_plane a arena:Terrain ;
    arena:registryName "default_ground_plane"^^xsd:string .

:franka_ik a arena:Embodiment ;
    arena:registryName "franka_ik"^^xsd:string ;
    arena:standoffDistance "0.85"^^xsd:float ;
    arena:standsAtAffordance :maple_table_robolab .

:franka_tomato_soup_can_bin_b03_viewer_cam a arena:Camera ;
    arena:lookAtTarget :tomato_soup_can_ycb_robolab ;
    arena:observes :tomato_soup_can_ycb_robolab ;
    arena:observesInteraction :tomato_soup_can_ycb_robolab .

:bin_b03_vomp_robolab a arena:Receptacle,
        arena:RigidObject ;
    arena:placedOn :maple_table_robolab ;
    arena:placedOnSubSurface :maple_table_robolab_table_top ;
    arena:registryName "bin_b03_vomp_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table_robolab_table_top a arena:SurfaceAnchor ;
    arena:anchorName "table_top"^^xsd:string .

:tomato_soup_can_ycb_robolab a arena:RigidObject ;
    arena:placedOn :maple_table_robolab ;
    arena:placedOnSubSurface :maple_table_robolab_table_top ;
    arena:registryName "tomato_soup_can_ycb_robolab"^^xsd:string ;
    arena:surfaceAnchor "table_top"^^xsd:string .

:maple_table_robolab a arena:Fixture ;
    arena:hasSubSurface :maple_table_robolab_table_top ;
    arena:registryName "maple_table_robolab"^^xsd:string .

