                    token[] semantics:labels:material = ["Lacquered tinplate, knurled"]
                    float physics:density = 7850
                    float physics:staticFriction = 0.5
                    float physics:dynamicFriction = 0.4
                    float physics:restitution = 0.3
                  }
        }

        def Scope "Joints"
