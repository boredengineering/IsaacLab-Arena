{
  "@context": {
    "@version": 1.1,
    "arena": "https://isaac-sim.github.io/arena/schema#",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "geo": "http://www.opengis.net/ont/geosparql#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",

    "EnvironmentGraph": "arena:EnvironmentGraph",
    "Terrain": "arena:Terrain",
    "Embodiment": "arena:Embodiment",
    "Fixture": "arena:Fixture",
    "RigidObject": "arena:RigidObject",
    "EvaluationRun": "arena:EvaluationRun",

    "id": "@id",
    "type": "@type",
    "env_name": "arena:envName",
    "has_terrain": { "@id": "arena:hasTerrain", "@type": "@id" },
    "has_embodiment": { "@id": "arena:hasEmbodiment", "@type": "@id" },
    "has_fixture": { "@id": "arena:hasFixture", "@type": "@id" },
    "has_object": { "@id": "arena:hasObject", "@type": "@id" },
    "registry_name": "arena:registryName",
    "usd_path": "arena:usdPath",
    "controller_binding": "arena:controllerBinding",
    "surface_anchor": "arena:surfaceAnchor",
    "nominal_height": { "@id": "arena:nominalHeight", "@type": "xsd:float" },
    "bound_x": { "@id": "arena:boundX", "@container": "@list" },
    "bound_y": { "@id": "arena:boundY", "@container": "@list" },
    "clearance": { "@id": "arena:requiredClearance", "@type": "xsd:float" },

    "placed_on": { "@id": "arena:placedOn", "@type": "@id" },
    "placed_inside": { "@id": "arena:placedInside", "@type": "@id" },
    "nav_corridor_to": { "@id": "arena:navCorridorTo", "@type": "@id" },

    "Policy": "arena:Policy",
    "PolicyArchitecture": "arena:PolicyArchitecture",
    "DemonstrationCorpus": "arena:DemonstrationCorpus",
    "TrainingInvariant": "arena:TrainingInvariant",
    "DistributionShift": "arena:DistributionShift",
    "FailureMode": "arena:FailureMode",
    "DiagnosticTechnique": "arena:DiagnosticTechnique",
    "ActivationProbe": "arena:ActivationProbe",
    "RemediationTechnique": "arena:RemediationTechnique",
    "ProbeObservation": "arena:ProbeObservation",

    "has_architecture": { "@id": "arena:hasArchitecture", "@type": "@id" },
    "was_trained_on": { "@id": "arena:wasTrainedOn", "@type": "@id" },
    "establishes_invariant": { "@id": "arena:establishesInvariant", "@type": "@id" },
    "reference_scene": { "@id": "arena:referenceScene", "@type": "@id" },
    "violates_invariant": { "@id": "arena:violatesInvariant", "@type": "@id" },
    "manifests_as": { "@id": "arena:manifestsAs", "@type": "@id" },
    "discriminates": { "@id": "arena:discriminates", "@type": "@id" },
    "resolves": { "@id": "arena:resolves", "@type": "@id" },
    "invalidated_by": { "@id": "arena:invalidatedBy", "@type": "@id" },
    "supports": { "@id": "arena:supports", "@type": "@id" },
    "refutes": { "@id": "arena:refutes", "@type": "@id" },
    "evaluated_policy": { "@id": "arena:evaluatedPolicy", "@type": "@id" },
    "applied_technique": { "@id": "arena:appliedTechnique", "@type": "@id" },
    "attributed_to_failure_mode": { "@id": "arena:attributedToFailureMode", "@type": "@id" },
    "remediated_by": { "@id": "arena:remediatedBy", "@type": "@id" },
    "next_technique": { "@id": "arena:nextTechnique", "@type": "@id" },

    "checkpoint_uri": "arena:checkpointUri",
    "policy_kind": "arena:policyKind",
    "language_instruction": "arena:languageInstruction",
    "action_dim": { "@id": "arena:actionDim", "@type": "xsd:integer" },
    "action_chunk_length": { "@id": "arena:actionChunkLength", "@type": "xsd:integer" },
    "demo_count": { "@id": "arena:demoCount", "@type": "xsd:integer" },
    "invariant_axis": "arena:invariantAxis",
    "invariant_value": "arena:invariantValue",
    "invariant_numeric_value": { "@id": "arena:invariantNumericValue", "@type": "xsd:float" },
    "invariant_tolerance": { "@id": "arena:invariantTolerance", "@type": "xsd:float" },
    "shift_axis": "arena:shiftAxis",
    "shift_magnitude": { "@id": "arena:shiftMagnitude", "@type": "xsd:float" },
    "shift_sigma": { "@id": "arena:shiftSigma", "@type": "xsd:float" },
    "within_tolerance": { "@id": "arena:withinTolerance", "@type": "xsd:boolean" },
    "failure_layer": "arena:failureLayer",
    "prior_belief": { "@id": "arena:priorBelief", "@type": "xsd:float" },
    "posterior_belief": { "@id": "arena:posteriorBelief", "@type": "xsd:float" },
    "technique_cost": { "@id": "arena:techniqueCost", "@type": "xsd:float" },
    "expected_efficacy": { "@id": "arena:expectedEfficacy", "@type": "xsd:float" },
    "observation_metric": "arena:observationMetric",
    "observation_value": { "@id": "arena:observationValue", "@type": "xsd:float" },
    "observation_reference": { "@id": "arena:observationReference", "@type": "xsd:float" },
    "likelihood_ratio": { "@id": "arena:likelihoodRatio", "@type": "xsd:float" },

    "was_generated_by": { "@id": "prov:wasGeneratedBy", "@type": "@id" },
    "was_derived_from": { "@id": "prov:wasDerivedFrom", "@type": "@id" },
    "used": { "@id": "prov:used", "@type": "@id" }
  }
}
